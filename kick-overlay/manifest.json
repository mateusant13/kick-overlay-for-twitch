{
  "name": "Kick & YouTube Overlay for Twitch",
  "description": "Kick & YouTube overlay for Twitch, plus a Twitch adblock: optional HTTP proxy for ad-free HD playlists, VOD CSAI blocking, and a reduced-quality clean-stream fallback when a live ad is already stitched.",
  "version": "0.8.35",
  "manifest_version": 3,
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "activeTab",
    "declarativeNetRequest",
    "proxy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ko-yt-origin",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://kick.com/*",
    "https://*.kick.com/*",
    "https://live-video.net/*",
    "https://*.live-video.net/*",
    "https://*.youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://*.ttvnw.net/*",
    "https://gql.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "player.html"
      ],
      "matches": [
        "https://www.twitch.tv/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtu.be/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "adblock-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "twitch-adblock.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtu.be/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kick & YouTube Overlay for Twitch",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
